---
// Com um 404.html no build, o Cloudflare Pages responde 404 para caminhos inexistentes
// em vez de servir a home com status 200 (modo SPA).
import ArtigosLayout from '../layouts/ArtigosLayout.astro';
---

<ArtigosLayout
  title="Página não encontrada | Daniel Camuçatto"
  description="Esta página não existe ou mudou de endereço."
>
  <p class="text-xs uppercase tracking-wider text-slate-500">Erro 404</p>
  <h1 class="!text-3xl sm:!text-4xl !mb-3 mt-1">Página não encontrada</h1>
  <p class="text-slate-600 dark:text-slate-400 mb-8">
    Esta página não existe ou mudou de endereço.
  </p>
  <div class="flex flex-wrap gap-6 text-sm font-semibold">
    <a href="/" class="text-teal-600 hover:text-teal-500 dark:text-teal-300 dark:hover:text-teal-200">Ir para a página inicial</a>
    <a href="/artigos/" class="text-teal-600 hover:text-teal-500 dark:text-teal-300 dark:hover:text-teal-200">Ver os artigos</a>
  </div>
</ArtigosLayout>
