---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import ArtigosLayout from '../../layouts/ArtigosLayout.astro';
import ShareButtons from '../../components/artigos/ShareButtons.astro';
import Comments from '../../components/artigos/Comments.astro';
import Cartao from '../../components/artigos/Cartao.astro';
import avatar from '../../assets/avatar.webp';
import { getArtigos, formatDate, readingTime, type Artigo } from '../../utils/artigos';
import { relacionados } from '../../utils/temas';

export async function getStaticPaths() {
  const artigos = await getArtigos();
  const resumidos = artigos.map((artigo) => ({ id: artigo.id, tags: artigo.data.tags, artigo }));
  return resumidos.map((atual) => ({
    params: { slug: atual.id },
    props: {
      artigo: atual.artigo,
      outros: relacionados(atual, resumidos, atual.artigo.data.related).map((item) => item.artigo),
    },
  }));
}

const { artigo, outros } = Astro.props as { artigo: Artigo; outros: Artigo[] };
const { Content, headings } = await render(artigo);
const { title, description, pubDate, updatedDate, tags, cover, devtoUrl } = artigo.data;
const secoes = headings.filter((h) => h.depth === 2);
const temIndice = secoes.length > 1;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Capa local passa pelo pipeline de imagens (WebP em vários tamanhos); capa externa vem do CDN do dev.to
const coverLocal = typeof cover === 'object' ? cover : undefined;
const coverRemota = typeof cover === 'string' ? cover : undefined;
// O CDN do dev.to informa o tamanho na URL (width=1000,height=420); reservar o espaço evita CLS
const [, larguraRemota = '1000', alturaRemota = '420'] = coverRemota?.match(/width=(\d+),height=(\d+)/) ?? [];
// og:image precisa de URL absoluta; JPG porque nem toda rede social aceita WebP na prévia
const ogImage = coverLocal
  ? new URL((await getImage({ src: coverLocal, width: 1200, format: 'jpg' })).src, Astro.site).href
  : coverRemota;
---

<ArtigosLayout
  title={`${title} | Daniel Camuçatto`}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={pubDate}
  voltar={{ href: '/artigos/', texto: 'Todos os artigos' }}
>
  <div class="barra-leitura" aria-hidden="true"></div>
  <article>
    <header class="cabecalho">
      <p class="rotulo">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && updatedDate > pubDate && <> · atualizado em {formatDate(updatedDate)}</>}
        {' '}· {readingTime(artigo.body)} min de leitura
      </p>
      <h1>{title}</h1>
      <p class="resumo muted">{description}</p>
      {tags.length > 0 && (
        <ul class="etiquetas">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      {coverLocal && (
        <Image
          src={coverLocal}
          alt=""
          widths={[400, 768, 1200, 1536]}
          sizes="(min-width: 860px) 820px, calc(100vw - 40px)"
          class="capa"
          priority
        />
      )}
      {coverRemota && (
        <img src={coverRemota} alt="" width={larguraRemota} height={alturaRemota} class="capa" loading="eager" fetchpriority="high" />
      )}
    </header>

    <div class:list={['leitura', { 'sem-indice': !temIndice }]}>
      {temIndice && (
        <details class="indice" open>
          <summary>Neste artigo</summary>
          <nav aria-label="Neste artigo">
            {secoes.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </details>
      )}
      <div class="prose" data-corpo>
        <Content />
      </div>
    </div>

    <footer class="depois">
      <ShareButtons url={canonical} title={title} />
      <div class="autor">
        <Image src={avatar} alt="Foto de Daniel Camuçatto" width={192} height={192} />
        <div>
          <p><strong>Daniel Camuçatto</strong></p>
          <p class="muted">Desenvolvedor Full Stack. Integro IA a negócios, com segurança, e escrevo sobre o que aprendo fazendo.</p>
          <a class="botao principal" href="/#contato" data-contato="artigo">Falar comigo</a>
        </div>
      </div>
      {devtoUrl && (
        <p class="muted">Também publicado no <a href={devtoUrl} rel="noopener">dev.to</a>.</p>
      )}
      <Comments />
    </footer>
  </article>

  {outros.length > 0 && (
    <section aria-labelledby="continue">
      <h2 class="secao" id="continue">Continue lendo</h2>
      <div class="grade">
        {outros.map((outro) => <div><Cartao artigo={outro} /></div>)}
      </div>
    </section>
  )}
</ArtigosLayout>

<script>
  const corpo = document.querySelector<HTMLElement>('[data-corpo]');
  const barra = document.querySelector<HTMLElement>('.barra-leitura');
  const indice = document.querySelector<HTMLDetailsElement>('.indice');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.indice a')];
  const alvos = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));

  // No celular o índice começa recolhido; no computador fica sempre aberto
  const estreito = matchMedia('(max-width: 900px)');
  if (indice) {
    const ajustar = () => (indice.open = !estreito.matches);
    ajustar();
    estreito.addEventListener('change', ajustar);
    indice.querySelector('summary')!.addEventListener('click', (e) => {
      if (!estreito.matches) e.preventDefault();
    });
  }

  const desenhar = () => {
    if (!corpo || !barra) return;
    const area = corpo.getBoundingClientRect();
    const lido = Math.min(1, Math.max(0, (innerHeight * 0.5 - area.top) / area.height));
    barra.style.width = `${lido * 100}%`;
    let atual = 0;
    alvos.forEach((alvo, i) => {
      if (alvo && alvo.getBoundingClientRect().top < innerHeight * 0.3) atual = i;
    });
    links.forEach((a, i) => a.setAttribute('aria-current', String(i === atual)));
  };
  addEventListener('scroll', desenhar, { passive: true });
  desenhar();
</script>
<script src="../../scripts/contato.ts"></script>
