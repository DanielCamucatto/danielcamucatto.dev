---
import BaseLayout from './BaseLayout.astro';
import SiteControls from '../components/SiteControls';
import '../styles/artigos.css';

type Props = Parameters<typeof BaseLayout>[0] & {
  voltar?: { href: string; texto: string };
};

const { voltar = { href: '/', texto: 'Início' }, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <div class="tema-cobre">
    <div class="wrap">
      <header class="topo">
        <nav aria-label="Navegação"><a href={voltar.href}>← {voltar.texto}</a></nav>
        <SiteControls client:load />
      </header>

      <main>
        <slot />
      </main>

      <footer class="rodape">
        © {new Date().getFullYear()} · <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </div>
</BaseLayout>
