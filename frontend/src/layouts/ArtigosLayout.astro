---
import BaseLayout from './BaseLayout.astro';
import SiteControls from '../components/SiteControls';

type Props = Parameters<typeof BaseLayout>[0];

const props = Astro.props;
---

<BaseLayout {...props}>
  <div class="w-full min-h-screen text-slate-900 dark:text-slate-100 transition-colors duration-300">
    <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <nav class="flex items-center gap-6 text-sm font-semibold">
        <a href="/" class="text-slate-800 hover:text-teal-600 dark:text-slate-200 dark:hover:text-teal-300">
          Daniel Camuçatto
        </a>
        <a href="/artigos" class="text-slate-600 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-300">
          Artigos
        </a>
      </nav>
      <SiteControls client:load />
    </header>

    <main class="mx-auto max-w-3xl px-6 pb-24">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl px-6 pb-12 text-sm text-slate-500">
      © {new Date().getFullYear()} Daniel Camuçatto · <a href="/rss.xml" class="hover:text-teal-600 dark:hover:text-teal-300">RSS</a>
    </footer>
  </div>
</BaseLayout>
